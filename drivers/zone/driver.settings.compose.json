[
  {
    "type": "group",
    "label": {
      "en": "Zone"
    },
    "children": [
      {
        "id": "heat_all_year",
        "type": "checkbox",
        "label": {
          "en": "Heat all year"
        },
        "value": false,
        "hint": {
          "en": "Keep heating in the cooling and off seasons, e.g. a bathroom floor."
        }
      },
      {
        "id": "occupancy_rule",
        "type": "dropdown",
        "label": {
          "en": "Occupancy"
        },
        "value": "follows",
        "hint": {
          "en": "Follows home: comfort when someone is home or coming home. Always eco: e.g. a guest room. Always comfort: ignores who is home."
        },
        "values": [
          {
            "id": "follows",
            "label": {
              "en": "Follows home"
            }
          },
          {
            "id": "always_eco",
            "label": {
              "en": "Always eco"
            }
          },
          {
            "id": "always_comfort",
            "label": {
              "en": "Always comfort"
            }
          }
        ]
      },
      {
        "id": "low_temp_alarm",
        "type": "number",
        "label": {
          "en": "Low temperature alarm"
        },
        "value": 10,
        "min": 0,
        "max": 20,
        "step": 0.5,
        "units": {
          "en": "°C"
        },
        "hint": {
          "en": "Zone problem alarm when the zone temperature falls below this, in every mode. The app does not heat for it. 0: no alarm."
        }
      },
      {
        "id": "boost_delta",
        "type": "number",
        "label": {
          "en": "Boost amount"
        },
        "value": 1,
        "min": 0,
        "max": 5,
        "step": 0.5,
        "units": {
          "en": "°C"
        },
        "hint": {
          "en": "Boost heats to comfort plus this. When cooling, boost uses comfort."
        }
      },
      {
        "id": "boost_minutes",
        "type": "number",
        "label": {
          "en": "Boost time"
        },
        "value": 60,
        "min": 5,
        "max": 720,
        "step": 5,
        "units": {
          "en": "min"
        },
        "hint": {
          "en": "How long boost lasts when started from the device or without a time."
        }
      },
      {
        "id": "window_delay_minutes",
        "type": "number",
        "label": {
          "en": "Eco after door/window open"
        },
        "value": 2,
        "min": 0,
        "max": 30,
        "step": 1,
        "units": {
          "en": "min"
        },
        "hint": {
          "en": "How long a linked door or window may be open before the zone goes to eco. 0: at once."
        }
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Prices"
    },
    "children": [
      {
        "id": "price_peak",
        "type": "dropdown",
        "label": {
          "en": "At price peaks"
        },
        "value": "eco",
        "hint": {
          "en": "Eco: the eco setpoint. Off: the zone's devices are switched off. Ignore: prices do not change this zone."
        },
        "values": [
          {
            "id": "eco",
            "label": {
              "en": "Eco"
            }
          },
          {
            "id": "off",
            "label": {
              "en": "Off"
            }
          },
          {
            "id": "ignore",
            "label": {
              "en": "Ignore"
            }
          }
        ]
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Outdoor limit"
    },
    "children": [
      {
        "id": "outdoor_limit",
        "type": "checkbox",
        "label": {
          "en": "Heat only when cold outside"
        },
        "value": false,
        "hint": {
          "en": "Uses the outdoor temperature set on the HVAC Controller."
        }
      },
      {
        "id": "outdoor_on_below",
        "type": "number",
        "label": {
          "en": "Heat below"
        },
        "value": -10,
        "min": -40,
        "max": 30,
        "step": 0.5,
        "units": {
          "en": "°C"
        }
      },
      {
        "id": "outdoor_off_above",
        "type": "number",
        "label": {
          "en": "Stop above"
        },
        "value": -8,
        "min": -40,
        "max": 30,
        "step": 0.5,
        "units": {
          "en": "°C"
        },
        "hint": {
          "en": "In between, heating stays as it was."
        }
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Members"
    },
    "children": [
      {
        "id": "members_repair_note",
        "type": "label",
        "label": {
          "en": "Devices"
        },
        "value": "Change with Repair",
        "hint": {
          "en": "Devices, roles and per-device options (thermostat step, relay controls and band, inverted relay, air conditioner eco and between-seasons mode) are changed with Repair, not here."
        }
      },
      {
        "id": "relay_min_minutes",
        "type": "number",
        "label": {
          "en": "Relay minimum on and off time"
        },
        "value": 5,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": {
          "en": "min"
        },
        "hint": {
          "en": "Protects relays and heaters from rapid switching."
        }
      }
    ]
  }
]
