{
  "name": {
    "en": "Heating Zone"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "measure_temperature",
    "target_temperature.comfort",
    "target_temperature.eco",
    "measure_humidity",
    "enum_zone_mode",
    "power_boost",
    "is_eco",
    "text_reason",
    "alarm_problem"
  ],
  "capabilitiesOptions": {
    "target_temperature.comfort": {
      "title": {
        "en": "Comfort heat"
      },
      "min": 5,
      "max": 30,
      "step": 0.5,
      "decimals": 1
    },
    "target_temperature.eco": {
      "title": {
        "en": "Eco heat"
      },
      "min": 5,
      "max": 30,
      "step": 0.5,
      "decimals": 1
    },
    "alarm_problem": {
      "title": {
        "en": "Zone problem"
      }
    },
    "power_boost": {
      "title": {
        "en": "Boost"
      },
      "uiComponent": "button",
      "icon": "./assets/capabilities/power_boost.svg"
    },
    "target_temperature": {
      "title": {
        "en": "Target now"
      },
      "setable": false,
      "min": 5,
      "max": 32,
      "step": 0.5,
      "decimals": 1
    }
  },
  "$extends": [
    "device"
  ],
  "pair": [
    {
      "id": "select",
      "navigation": {
        "next": "configure"
      }
    },
    {
      "id": "configure",
      "navigation": {
        "prev": "select"
      }
    }
  ],
  "repair": [
    {
      "id": "select",
      "navigation": {
        "next": "configure"
      }
    },
    {
      "id": "configure",
      "navigation": {
        "prev": "select"
      }
    }
  ]
}
