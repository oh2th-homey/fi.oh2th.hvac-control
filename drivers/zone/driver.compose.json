{
  "name": {
    "en": "Heating Zone"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "num_setback",
    "measure_temperature.set_target",
    "measure_temperature",
    "measure_humidity",
    "enum_zone_mode",
    "power_boost",
    "is_eco",
    "text_reason",
    "alarm_problem"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "title": {
        "en": "Comfort heat"
      },
      "min": 5,
      "max": 30,
      "step": 0.5,
      "decimals": 1
    },
    "alarm_problem": {
      "title": {
        "en": "Zone problem"
      }
    },
    "power_boost": {
      "title": {
        "en": "Boost"
      },
      "uiComponent": "button",
      "icon": "./assets/capabilities/power_boost.svg"
    },
    "measure_temperature.set_target": {
      "title": {
        "en": "Target now"
      },
      "decimals": 1
    }
  },
  "$extends": [
    "device"
  ],
  "pair": [
    {
      "id": "select",
      "navigation": {
        "next": "configure"
      }
    },
    {
      "id": "configure",
      "navigation": {
        "prev": "select"
      }
    }
  ],
  "repair": [
    {
      "id": "select",
      "navigation": {
        "next": "configure"
      }
    },
    {
      "id": "configure",
      "navigation": {
        "prev": "select"
      }
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Zone"
      },
      "children": [
        {
          "id": "has_cooling",
          "type": "checkbox",
          "label": {
            "en": "Has cooling"
          },
          "value": false,
          "hint": {
            "en": "The zone has cooling, for example an air conditioner or air-to-air heat pump. Shows the Comfort cool setpoint. Without cooling, the zone's members are off in the cooling season."
          }
        },
        {
          "id": "occupancy_rule",
          "type": "dropdown",
          "label": {
            "en": "Occupancy"
          },
          "value": "follows",
          "hint": {
            "en": "Follows home: comfort when someone is home or coming home. Always eco: eco until boosted, for example a guest room."
          },
          "values": [
            {
              "id": "follows",
              "label": {
                "en": "Follows home"
              }
            },
            {
              "id": "always_eco",
              "label": {
                "en": "Always eco"
              }
            }
          ]
        },
        {
          "id": "low_temp_alarm",
          "type": "number",
          "label": {
            "en": "Low temperature alarm"
          },
          "value": 5,
          "min": 0,
          "max": 20,
          "step": 0.5,
          "units": {
            "en": "°C"
          },
          "hint": {
            "en": "Zone problem alarm when the zone temperature falls below this, in every mode. The app does not heat for it. 0: no alarm."
          }
        },
        {
          "id": "boost_delta",
          "type": "number",
          "label": {
            "en": "Boost amount"
          },
          "value": 1,
          "min": 0,
          "max": 5,
          "step": 0.5,
          "units": {
            "en": "°C"
          },
          "hint": {
            "en": "Boost heats to comfort plus this. When cooling, boost uses comfort."
          }
        },
        {
          "id": "boost_minutes",
          "type": "number",
          "label": {
            "en": "Boost time"
          },
          "value": 60,
          "min": 5,
          "max": 720,
          "step": 5,
          "units": {
            "en": "min"
          },
          "hint": {
            "en": "How long boost lasts when started from the device or without a time."
          }
        },
        {
          "id": "window_delay_minutes",
          "type": "number",
          "label": {
            "en": "Eco after door/window open"
          },
          "value": 2,
          "min": 0,
          "max": 30,
          "step": 1,
          "units": {
            "en": "min"
          },
          "hint": {
            "en": "How long a linked door or window may be open before the zone goes to eco. 0: at once."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Members"
      },
      "children": [
        {
          "id": "hold_minutes",
          "type": "number",
          "label": {
            "en": "Minimum hold time"
          },
          "value": 30,
          "min": 0,
          "max": 240,
          "step": 5,
          "units": {
            "en": "min"
          },
          "hint": {
            "en": "A price change waits at least this long after the last write to a member. Occupancy, mode and setpoint changes are written at once."
          }
        },
        {
          "id": "hysteresis",
          "type": "number",
          "label": {
            "en": "Setpoint hysteresis"
          },
          "value": 0.2,
          "min": 0,
          "max": 1,
          "step": 0.1,
          "units": {
            "en": "°C"
          },
          "hint": {
            "en": "A thermostat moves to the next step only when the target passes the midpoint by this much."
          }
        },
        {
          "id": "relay_min_minutes",
          "type": "number",
          "label": {
            "en": "Relay minimum on and off time"
          },
          "value": 5,
          "min": 0,
          "max": 60,
          "step": 1,
          "units": {
            "en": "min"
          },
          "hint": {
            "en": "Protects relays and heaters from rapid switching."
          }
        },
        {
          "id": "sensor_stale_minutes",
          "type": "number",
          "label": {
            "en": "Sensor timeout"
          },
          "value": 0,
          "min": 0,
          "max": 1440,
          "step": 10,
          "units": {
            "en": "min"
          },
          "hint": {
            "en": "A climate sensor is used while it is available in Homey. Optionally also ignore a reading not updated for this long. 0: off, for sensors that only report changes or are set by flows."
          }
        }
      ]
    }
  ]
}
