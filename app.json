    },
    {
      "platforms": [
        "local"
      ],
      "connectivity": [],
      "images": {
        "small": "/drivers/zone/assets/images/small.png",
        "large": "/drivers/zone/assets/images/large.png"
      },
      "name": {
        "en": "Heating Zone"
      },
      "class": "thermostat",
      "capabilities": [
        "target_temperature",
        "target_temperature.eco",
        "measure_temperature.set_target",
        "measure_temperature",
        "measure_humidity",
        "enum_zone_mode",
        "power_boost",
        "is_eco",
        "text_reason",
        "alarm_problem"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "title": {
            "en": "Comfort heat"
          },
          "min": 5,
          "max": 30,
          "step": 0.5,
          "decimals": 1
        },
        "target_temperature.eco": {
          "title": {
            "en": "Eco heat"
          },
          "min": 5,
          "max": 30,
          "step": 0.5,
          "decimals": 1
        },
        "alarm_problem": {
          "title": {
            "en": "Zone problem"
          }
        },
        "power_boost": {
          "title": {
            "en": "Boost"
          },
          "uiComponent": "button",
          "icon": "./assets/capabilities/power_boost.svg"
        },
        "measure_temperature.set_target": {
          "title": {
            "en": "Target now"
          },
          "decimals": 1
        }
      },
      "pair": [
        {
          "id": "select",
          "navigation": {
            "next": "configure"
          }
        },
        {
          "id": "configure",
          "navigation": {
            "prev": "select"
          }
        }
      ],
      "repair": [
        {
          "id": "select",
