  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Occupancy changed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "tokens": [
          {
            "name": "enum_occupancy",
            "type": "string",
            "title": {
              "en": "Occupancy"
            },
            "example": {
              "en": "Away"
            }
          }
        ],
        "id": "enum_occupancy_changed"
      },
      {
        "title": {
          "en": "Eco changed"
        },
        "hint": {
          "en": "Use it to run other actions when the zone enters or leaves eco, for example an air conditioner's own fan mode."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "tokens": [
          {
            "name": "is_eco",
            "type": "boolean",
            "title": {
              "en": "Eco"
            },
            "example": true
          }
        ],
        "id": "is_eco_changed"
      },
      {
        "title": {
          "en": "Expensive now changed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "tokens": [
          {
            "name": "is_expensive",
            "type": "boolean",
            "title": {
              "en": "Expensive now"
            },
            "example": true
          }
        ],
        "id": "is_expensive_changed"
      },
      {
        "title": {
          "en": "Long absence changed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "tokens": [
          {
            "name": "is_long_absence",
            "type": "boolean",
            "title": {
              "en": "Long absence"
            },
            "example": true
          }
        ],
        "id": "is_long_absence_changed"
      },
      {
        "title": {
          "en": "Target changed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "tokens": [
          {
            "name": "measure_temperature_set_target",
            "type": "number",
            "title": {
              "en": "Target"
            },
            "example": 21
          },
          {
            "name": "text_reason",
            "type": "string",
            "title": {
              "en": "Reason"
            },
            "example": {
              "en": "Away: eco"
            }
          }
        ],
        "id": "measure_temperature_set_target_changed"
      },
      {
        "title": {
          "en": "Member write failed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "tokens": [
          {
            "name": "member",
            "type": "string",
            "title": {
              "en": "Member"
            },
            "example": {
              "en": "Floor thermostat"
            }
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason"
            },
            "example": {
              "en": "Reported 4.0 after writing 21"
            }
          }
        ],
        "id": "member_write_failed"
      },
      {
        "title": {
          "en": "Prices imported"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "tokens": [
          {
            "name": "day",
            "type": "string",
            "title": {
              "en": "Day"
            },
            "example": {
              "en": "tomorrow"
            }
          },
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Number of prices"
            },
            "example": 96
          }
        ],
        "id": "prices_imported"
      },
      {
        "title": {
          "en": "Prices missing for tomorrow"
        },
        "hint": {
          "en": "Runs once a day at the check time set in the HVAC Controller settings, when tomorrow's prices are still missing or partial."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "tokens": [
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Number of prices"
            },
            "example": 0
          }
        ],
        "id": "prices_missing_tomorrow"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Occupancy is"
        },
        "titleFormatted": {
          "en": "Occupancy !{{is|is not}} [[occupancy]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          },
          {
            "type": "dropdown",
            "name": "occupancy",
            "title": {
              "en": "Occupancy"
            },
            "values": [
              {
                "id": "present",
                "title": {
                  "en": "Present"
                }
              },
              {
                "id": "coming_home",
                "title": {
                  "en": "Coming Home"
                }
              },
              {
                "id": "away",
                "title": {
                  "en": "Away"
                }
              }
            ]
          }
        ],
        "id": "enum_occupancy_is"
      },
      {
        "title": {
          "en": "Zone mode is"
        },
        "titleFormatted": {
          "en": "Zone mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode"
            },
            "values": [
              {
                "id": "auto",
                "title": {
                  "en": "Auto"
                }
              },
              {
                "id": "manual",
                "title": {
                  "en": "Manual"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "Off"
                }
              }
            ]
          }
        ],
        "id": "enum_zone_mode_is"
      },
      {
        "title": {
          "en": "Zone is in eco"
        },
        "titleFormatted": {
          "en": "Zone !{{is|is not}} in eco"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "id": "is_eco"
      },
      {
        "title": {
          "en": "Price is expensive"
        },
        "titleFormatted": {
          "en": "Price !{{is|is not}} expensive now"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "id": "is_expensive"
      },
      {
        "title": {
          "en": "Long absence is on"
        },
        "titleFormatted": {
          "en": "Long absence !{{is|is not}} on"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "id": "is_long_absence"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Follow home for 24 hours"
        },
        "hint": {
          "en": "E.g. guests in a guest room. Running it again adds 24 hours. Afterwards the zone returns to its Occupancy setting."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "id": "add_num_follow_home_hours"
      },
      {
        "title": {
          "en": "End long absence"
        },
        "hint": {
          "en": "Zones return to following occupancy and prices."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          }
        ],
        "id": "end_long_absence"
      },
      {
        "title": {
          "en": "Import prices"
        },
        "titleFormatted": {
          "en": "Import [[day]] prices [[prices]]"
        },
        "hint": {
          "en": "Use the price token of your energy price app: a JSON array of one day's quarter-hour (or hourly) prices per kWh, starting at local midnight. Tomorrow's prices may be partial or empty."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          },
          {
            "type": "dropdown",
            "name": "day",
            "title": {
              "en": "Day"
            },
            "values": [
              {
                "id": "today",
                "title": {
                  "en": "today's"
                }
              },
              {
                "id": "tomorrow",
                "title": {
                  "en": "tomorrow's"
                }
              }
            ]
          },
          {
            "type": "text",
            "name": "prices",
            "title": {
              "en": "Prices"
            },
            "placeholder": {
              "en": "[0.0959,0.0804,…]"
            }
          }
        ],
        "id": "import_prices"
      },
      {
        "title": {
          "en": "Use own occupancy setting"
        },
        "hint": {
          "en": "Ends Follow home now."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "id": "reset_num_follow_home_hours"
      },
      {
        "title": {
          "en": "Set long absence until"
        },
        "titleFormatted": {
          "en": "Set long absence until [[date]]"
        },
        "hint": {
          "en": "Everyone is away for days. Starts now: zones go to eco and stop cooling until the end of the given day."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          },
          {
            "type": "date",
            "name": "date",
            "title": {
              "en": "Last day of absence"
            }
          }
        ],
        "id": "set_absence_until"
      },
      {
        "title": {
          "en": "Set occupancy"
        },
        "titleFormatted": {
          "en": "Set occupancy to [[occupancy]]"
        },
        "hint": {
          "en": "Present: someone is home. Coming Home: someone is on the way home. Away: nobody is home. Use any presence source you like, such as presence, geofence or a switch."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hvac"
          },
          {
            "type": "dropdown",
            "name": "occupancy",
            "title": {
              "en": "Occupancy"
            },
            "values": [
              {
                "id": "present",
                "title": {
                  "en": "Present"
                }
              },
              {
                "id": "coming_home",
                "title": {
                  "en": "Coming Home"
                }
              },
              {
                "id": "away",
                "title": {
                  "en": "Away"
                }
              }
            ]
          }
        ],
        "id": "set_enum_occupancy"
      },
      {
        "title": {
          "en": "Set zone mode"
        },
        "titleFormatted": {
          "en": "Set zone mode to [[mode]]"
        },
        "hint": {
          "en": "Auto, manual or off. Boost is separate: use Boost zone."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Mode"
            },
            "values": [
              {
                "id": "auto",
                "title": {
                  "en": "Auto"
                }
              },
              {
                "id": "manual",
                "title": {
                  "en": "Manual"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "Off"
                }
              }
            ]
          }
        ],
        "id": "set_enum_zone_mode"
      },
      {
        "title": {
          "en": "Boost zone"
        },
        "titleFormatted": {
          "en": "Boost for [[minutes]] minutes"
        },
        "hint": {
          "en": "Turns boost on: heat to comfort plus the boost amount (cooling: comfort), then back to normal. Also sets the zone mode to Auto. Empty time: the boost time from the zone settings."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Minutes"
            },
            "required": false,
            "min": 1,
            "max": 1440,
            "step": 1,
            "placeholder": {
              "en": "60"
            }
          }
        ],
        "id": "set_power_boost"
      },
      {
        "title": {
          "en": "Set comfort cool"
        },
        "titleFormatted": {
          "en": "Set comfort cool to [[temperature]] °C"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "type": "number",
            "name": "temperature",
            "title": {
              "en": "Temperature"
            },
            "min": 16,
            "max": 32,
            "step": 0.5
          }
        ],
        "hint": {
          "en": "Only for zones with an air conditioner."
        },
        "id": "set_target_temperature_cool"
      },
      {
        "title": {
          "en": "Set eco heat"
        },
        "titleFormatted": {
          "en": "Set eco heat to [[temperature]] °C"
        },
        "hint": {
          "en": "The temperature when nobody is home or the price is expensive. Not above comfort heat: comfort follows if needed."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "type": "number",
            "name": "temperature",
            "title": {
              "en": "Temperature"
            },
            "min": 5,
            "max": 30,
            "step": 0.5
          }
        ],
        "id": "set_target_temperature_eco"
      },
      {
        "title": {
          "en": "Set eco cool"
        },
        "titleFormatted": {
          "en": "Set eco cool to [[temperature]] °C"
        },
        "hint": {
          "en": "Only for zones with an air conditioner. Not below comfort cool: comfort follows if needed."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "type": "number",
            "name": "temperature",
            "title": {
              "en": "Temperature"
            },
            "min": 16,
            "max": 32,
            "step": 0.5
          }
        ],
        "id": "set_target_temperature_eco_cool"
      }
    ]
  },
  "drivers": [
    {
      "platforms": [
        "local"
      ],
      "connectivity": [],
      "images": {
        "small": "/drivers/hvac/assets/images/small.png",
        "large": "/drivers/hvac/assets/images/large.png"
      },
      "name": {
        "en": "HVAC Controller"
      },
      "class": "other",
      "capabilities": [
        "enum_occupancy",
        "thermostat_mode",
