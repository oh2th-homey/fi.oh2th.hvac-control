{
  "title": {
    "en": "Set price model"
  },
  "titleFormatted": {
    "en": "Set price model to [[model]] with [[pct]] %"
  },
  "hint": {
    "en": "Rate is highest flags short price peaks and needs 15-minute prices. Above average flags prices the given percentage above today's average. The percentage is only used by Above average."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=hvac"
    },
    {
      "type": "dropdown",
      "name": "model",
      "title": {
        "en": "Price model"
      },
      "values": [
        {
          "id": "rate_is_highest",
          "title": {
            "en": "Rate is highest"
          }
        },
        {
          "id": "above_average",
          "title": {
            "en": "Above average"
          }
        },
        {
          "id": "off",
          "title": {
            "en": "Off"
          }
        }
      ]
    },
    {
      "type": "number",
      "name": "pct",
      "title": {
        "en": "Percentage"
      },
      "required": false,
      "min": 0,
      "max": 500,
      "step": 1,
      "placeholder": {
        "en": "30"
      }
    }
  ]
}
