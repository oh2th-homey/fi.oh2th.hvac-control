    {
      "type": "number",
      "name": "minutes",
      "title": {
        "en": "Minutes"
      },
      "required": false,
      "min": 1,
      "max": 1440,
      "step": 1,
      "placeholder": {
        "en": "60"
      }
    }
  ]
}
