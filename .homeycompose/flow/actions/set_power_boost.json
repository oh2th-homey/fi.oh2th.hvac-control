{
  "title": {
    "en": "Boost zone"
  },
  "titleFormatted": {
    "en": "Boost for [[minutes]] minutes"
  },
  "hint": {
    "en": "Turns boost on: heat to comfort plus the boost amount (cooling: comfort), then back to normal. Also sets the zone mode to Auto. Empty time: the boost time from the zone settings."
  },
